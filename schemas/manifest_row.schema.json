{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pv/manifest-row.schema.json",
  "title": "PlantVillage canonical manifest row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "relative_path",
    "source_split",
    "split",
    "class_id",
    "class_name",
    "leaf_id",
    "group_id",
    "width",
    "height",
    "mode",
    "file_sha256",
    "selection_rank"
  ],
  "properties": {
    "sample_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {"type": "string", "pattern": "^raw/color/"},
    "source_split": {"enum": ["official_train", "official_test"]},
    "split": {"enum": ["train", "val", "test"]},
    "class_id": {"type": "integer", "minimum": 0, "maximum": 3},
    "class_name": {"type": "string"},
    "leaf_id": {"type": "string", "minLength": 1},
    "group_id": {"type": "string", "minLength": 1},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "mode": {"const": "RGB"},
    "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_rank": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
